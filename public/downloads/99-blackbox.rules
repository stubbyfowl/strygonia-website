# BlackBox (Strygonia): only needed for the AppImage; the .deb installs this automatically.
# Lets logged-in users use BlackBox without root and keeps ModemManager off it.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0666", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
# its USB firmware-update (DFU) mode
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", MODE="0666", TAG+="uaccess"
